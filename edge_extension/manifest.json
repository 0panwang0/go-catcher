{
  "manifest_version": 3,
  "name": "M3U8 Video Catcher",
  "version": "0.5.0",
  "description": "嗅探网页中的 m3u8 视频并一键下载（自动注入 Referer，走浏览器系统代理/Clash）",
  "permissions": [
    "storage",
    "webRequest",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_idle",
      "js": [
        "content.js"
      ]
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_idle",
      "world": "MAIN",
      "js": [
        "content-main.js"
      ]
    }
  ],
  "action": {
    "default_title": "M3U8 下载器"
  }
}
